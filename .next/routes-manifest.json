      "regex": "^/api/verify\\-delivery\\-zone(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/verify\\-delivery\\-zone(?:/)?$"
    },
    {
      "page": "/api/webhooks",
      "regex": "^/api/webhooks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/webhooks(?:/)?$"
    },
    {
      "page": "/auth/callback",
      "regex": "^/auth/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/callback(?:/)?$"
    },
    {
      "page": "/checkout",
      "regex": "^/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout(?:/)?$"
    },
    {
      "page": "/home",
      "regex": "^/home(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/home(?:/)?$"
    },
    {
      "page": "/icon.png",
      "regex": "^/icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.png(?:/)?$"
    },
    {
      "page": "/menu",
      "regex": "^/menu(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/menu(?:/)?$"
    },
    {
      "page": "/offers",
      "regex": "^/offers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/offers(?:/)?$"
    },
    {
      "page": "/products",
      "regex": "^/products(?:/)?$",
